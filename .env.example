# DeepSeek OpenAI-compatible endpoint. Replace only the key in local .env.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096
LLM_THINKING_ENABLED=false
LLM_REASONING_EFFORT=low

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

DATABASE_URL=postgresql://aiqasys:aiqasys@localhost:5432/aiqasys
QA_DISABLE_POSTGRES=false
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
PG_HNSW_EF_SEARCH=100

RAG_TOP_K=6
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSIONS=2048
SEMANTIC_TOP_K=8
QA_GRAPH_LIMIT=50
QA_ENABLE_LLM_CYPHER=false
QA_ENABLE_LLM_PLANNER=false
QA_ENABLE_AGENT=true
QA_AGENT_MAX_STEPS=4
QA_AGENT_RUNNER=langgraph
QA_MULTI_AGENT_MAX_WORKERS=5
QA_MULTI_AGENT_MAX_LLM_CALLS=12
QA_MULTI_AGENT_TASK_TIMEOUT_SECONDS=90
QA_CONTEXTUALIZER_MODE=auto
QA_ENABLE_HYDE=true
QA_HYDE_QUERY_MODE=hybrid
QA_HYDE_MAX_CHARS=700
KG_DATA_DIR=data/curated
QA_GRAPH_BACKEND=auto
QA_CORE_COMPANIES_ONLY=true
QA_RERANK_TOP_N=12
QA_EVIDENCE_TOP_N=6
QA_HISTORY_MAX_TURNS=3
QA_HISTORY_MAX_CHARS=4000
QA_HISTORY_COMPRESSION_ENABLED=true
QA_HISTORY_SUMMARY_MAX_CHARS=1600
QA_HISTORY_COMPRESSION_CHUNK_CHARS=12000
QA_UI_RENDER_LATEST_ONLY=true
